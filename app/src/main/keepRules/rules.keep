# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}

# Kotlin multifile facades (e.g. StringsKt, FlowKt, SnapshotStateKt) compile to a chain of
# package-private part classes `XxxKt__PartKt` that extend each other. With the release
# `optimization.packageScope` (androidx/kotlin/kotlinx), R8 repackages some parts to the root
# package while their package-private superclass stays behind, which fails at class-load time
# with `IllegalAccessError: Class kotlin.text.p extended by class el3 is inaccessible`.
# Keeping only the part class names pins them to their original package; their members are
# still shrunk, optimized and obfuscated.
-keep,allowshrinking,allowoptimization class kotlin.**Kt__*
-keep,allowshrinking,allowoptimization class kotlinx.**Kt__*
-keep,allowshrinking,allowoptimization class androidx.**Kt__*
